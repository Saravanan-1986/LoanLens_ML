# ===========================================================================
# LoanLens - example environment file
# Copy this file to `.env` (root) and fill in your own values.
#   cp .env.example .env
# The repository root `.env` is read by the Node backend and is also
# used to build the frontend base URL for local development.
# ===========================================================================

# ---------------------------------------------------------------------------
# Node / Express backend
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# MongoDB
# Leave MONGODB_URI empty to run with the built-in in-memory store
# (handy for the end-to-end demo without installing MongoDB).
# ---------------------------------------------------------------------------
MONGODB_URI=

# ---------------------------------------------------------------------------
# Python FastAPI ML service
# ---------------------------------------------------------------------------
ML_SERVICE_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=60000
ML_SERVICE_PORT=8000

# ---------------------------------------------------------------------------
# File uploads
# ---------------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# ---------------------------------------------------------------------------
# Authentication
# Secret used to sign session tokens (HMAC-SHA256). In production set a long,
# random value: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
# When left empty a development-only secret is derived per boot, which
# invalidates existing sessions on restart.
# ---------------------------------------------------------------------------
AUTH_SECRET=
AUTH_TOKEN_TTL_HOURS=168

# ---------------------------------------------------------------------------
# Legacy demo / seed data
# Demo data is no longer part of the product. Purging is on by default so any
# records left behind by an older build are deleted on startup and the library
# only ever holds real analyses.
# ---------------------------------------------------------------------------
DEMO_MODE=false
SEED_DEMO_DATA=false
PURGE_DEMO_DATA=true

# ---------------------------------------------------------------------------
# Frontend (Vite)
# Only VITE_* variables are exposed to the browser bundle.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=/api

# ---------------------------------------------------------------------------
# Optional - ML model settings (used by ml-service when weights are present).
# The service runs with a clearly-labelled heuristic fallback when these
# files are missing. Never commit downloaded weights.
# ---------------------------------------------------------------------------
ML_CLASSIFIER_MODEL=distilbert-base-uncased
ML_CLASSIFIER_WEIGHTS=
ML_SUMMARIZER_MODEL=t5-small
ML_SUMMARIZER_WEIGHTS=
ENABLE_TRANSFORMERS=false
OCR_LANG=eng
